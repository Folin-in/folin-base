# Copy to .env and fill required values. Optional values are marked below.

# Authentication
JWT_SECRET=                         # >= 32 random chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_DAYS=30
CONSENT_VERSION=2026-01
GOOGLE_CLIENT_IDS=                  # optional, comma-separated OAuth client IDs
APPLE_BUNDLE_ID=com.folin.app

# Supabase Postgres and private report storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=               # sb_secret_...; never expose to the app
SUPABASE_DB_URL=                    # postgresql://...; URL-encode password characters

# Gemini document analysis
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite  # comma-separated, in failover order

# Product and quota
FREE_TOTAL_ANALYSES=2
PRO_TERM_DAYS=90
PRO_PRICE_INR=299
ALLOW_SELF_SERVE_PRO=false

# Google Play subscriptions
GOOGLE_PLAY_PACKAGE_NAME=com.folin.app
GOOGLE_PLAY_PRO_PRODUCT_ID=          # immutable subscription product ID created in Play Console
GOOGLE_PLAY_PRO_BASE_PLAN_ID=        # base plan to sell; blank accepts the product's active line item
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=    # complete service-account JSON on one line (secret)
GOOGLE_PLAY_RTDN_AUDIENCE=           # exact HTTPS push endpoint configured in Pub/Sub
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL= # identity used by the authenticated Pub/Sub push subscription

# Email and invitations
APP_INVITE_URL=https://folin.in
RESEND_API_KEY=                     # optional; leave blank to disable invite email
RESEND_FROM=                        # required only when RESEND_API_KEY is set
EARLY_ACCESS_FROM=Folin <support@folin.in>
EARLY_ACCESS_CONFIRM_URL=https://api.folin.in/api/early-access/confirm
EARLY_ACCESS_WEB_URL=https://folin.in
EARLY_ACCESS_DAILY_LIMIT=80          # below Resend free plan's 100/day limit
EARLY_ACCESS_IP_HOURLY_LIMIT=5
EARLY_ACCESS_IP_MINUTE_LIMIT=3
EARLY_ACCESS_CONFIRMATION_COOLDOWN_MINUTES=1440
EARLY_ACCESS_CONFIRMATION_EXPIRE_HOURS=24
TURNSTILE_SECRET_KEY=               # required for the public early-access endpoint
TURNSTILE_EXPECTED_HOSTNAME=folin.in
TURNSTILE_EXPECTED_ACTION=early_access
RESEND_WEBHOOK_SECRET=              # whsec_... from the Resend webhook settings
SMTP_HOST=                          # optional; leave blank to disable password-reset email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Expo Push Service (optional unless enhanced push security is enabled in EAS)
EXPO_ACCESS_TOKEN=

# Network and administration
CORS_ALLOWED_ORIGINS=http://localhost:8081  # comma-separated, or * for development
TRUSTED_PROXY_IPS=                  # comma-separated IPs/CIDRs; blank when no trusted proxy
ADMIN_EMAILS=                       # optional, comma-separated
