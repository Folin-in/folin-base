# Copy to .env and fill in. Every value is required unless marked optional.
JWT_SECRET=            # >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=  # sb_secret_... (Project Settings -> API keys -> Secret keys)
SUPABASE_DB_URL=       # postgresql://... (URL-encode special chars in the password)

# Optional
# ANALYZE_DAILY_LIMIT=2
# GOOGLE_CLIENT_IDS=       # comma-separated OAuth client IDs to enable Google login
# APPLE_BUNDLE_ID=com.vitalquest.app
# RESEND_API_KEY=          # family invite emails
# SMTP_HOST=               # password reset emails (plus SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_FROM)
